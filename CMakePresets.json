{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "hidden": false,
      "generator": "Ninja",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "makefiles-debug",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "makefiles-release",
      "hidden": false,
      "generator": "Unix Makefiles",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "inherits": "ninja-debug",
      "name": "vscode-win-debug",
      "hidden": false,
      "cacheVariables": {
        "VSCODE_DEBUG_JSON_TYPE": "cppvsdbg",
        "VSCODE_DEBUG_JSON_MIMODE": null
      }
    },
    {
      "inherits": "makefiles-debug",
      "name": "vscode-mac-debug",
      "hidden": false,
      "cacheVariables": {
        "VSCODE_DEBUG_JSON_TYPE": "cppdbg",
        "VSCODE_DEBUG_JSON_MIMODE": "lldb"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-win-debug",
      "hidden": false,
      "configurePreset": "vscode-win-debug",
      "jobs": 4
    },
    {
      "name": "vscode-mac-debug",
      "hidden": false,
      "configurePreset": "vscode-mac-debug",
      "jobs": 4
    }
  ]
}